<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Metadata -->
    <Authors>titidatiti</Authors>
    <Company>MapleDorm</Company>
    <Product>TrayFolder</Product>
    <Description>A Windows tray application that simulates the "Add folder to taskbar" functionality.</Description>
    <Copyright>Copyright © 2025 MapleDorm</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)\dist\win-x64\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Helpers\ShellContextMenuHelper.cs" />
    <Compile Remove="ShellContextMenuHost\**\*.cs" />
    <ApplicationDefinition Remove="ShellContextMenuHost\**\*.xaml" />
    <Page Remove="ShellContextMenuHost\**\*.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <ShellHostProject>$(MSBuildProjectDirectory)\ShellContextMenuHost\TrayFolder.ShellHost.csproj</ShellHostProject>
    <ShellHostOutput>$(MSBuildProjectDirectory)\ShellContextMenuHost\bin\$(Configuration)\net48</ShellHostOutput>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ShellHostOutput)\TrayFolder.ShellHost.exe"
                      LogicalName="TrayFolder.Embedded.TrayFolder.ShellHost.exe" />
    <EmbeddedResource Include="$(ShellHostOutput)\TrayFolder.ShellHost.exe.config"
                      LogicalName="TrayFolder.Embedded.TrayFolder.ShellHost.exe.config" />
  </ItemGroup>

  <Target Name="RestoreShellContextMenuHost" BeforeTargets="Restore">
    <MSBuild Projects="$(ShellHostProject)" Targets="Restore" />
  </Target>

  <Target Name="BuildShellContextMenuHost" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="$(ShellHostProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
